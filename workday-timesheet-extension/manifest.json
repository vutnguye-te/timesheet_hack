{
  "manifest_version": 3,
  "name": "Workday Timesheet Autofill (PD Import)",
  "version": "0.1.0",
  "description": "Upload PagerDuty-derived data and autofill Workday timesheet drafts (never submit).",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://workday.cisco.com/*",
    "https://*.myworkday.com/*"
  ],
  "action": {
    "default_title": "Workday Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://workday.cisco.com/*",
        "https://*.myworkday.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
